# HTTP-only шаблон. Блок `listen 8443 ssl` (Jenkins публикуется по HTTPS на 8443,
# т.к. 443 занят другим сайтом) и редирект HTTP -> HTTPS добавляет certbot при
# деплое: `certbot --nginx --https-port 8443 --redirect` (см. bootstrap.sh).
# Порт 80 остаётся — по нему идёт ACME-проверка и редирект на 8443.
server {
  listen 80;
  server_name ${DOMAIN};

  location / {
    proxy_pass http://127.0.0.1:18080;

    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
